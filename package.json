{
  "name": "obsidian-jotback",
  "version": "1.0.1",
  "description": "Capture short thoughts and bring them back into view over time in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src --max-warnings=0",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "obsidian",
    "notes",
    "memo",
    "random-review"
  ],
  "author": "yniany",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.29",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "esbuild": "0.17.3",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.9.5"
  }
}
